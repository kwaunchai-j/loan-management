# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
TZ=Asia/Bangkok
# Matches docker-compose.yml at the project root (development only).
DATABASE_URL=postgresql://loan:CHANGE_ME@localhost:5433/loan_management?schema=public
# Signs login session tokens. Use a long random value (>= 32 chars); never commit the real one.
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_OF_32_CHARS_OR_MORE
# Only read by `npm run admin:create` (first admin) and `npm run admin:reset` (forgotten admin password).
# Remove ADMIN_PASSWORD from the environment afterwards.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# Encrypts borrower bank account numbers in the database (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK THIS KEY UP SEPARATELY FROM THE DATABASE: without it the encrypted values cannot be recovered.
FIELD_ENCRYPTION_KEY=CHANGE_ME_GENERATE_32_RANDOM_BYTES_AS_BASE64
# Number of reverse proxies in front of the API (0 = none). Set to 1 behind a single proxy so login
# throttling sees real client IPs; never set it when the API is directly exposed.
# TRUST_PROXY=0
# Folder for transfer slips (on the Thai server; only ADMIN can read them through the API) and the
# largest accepted slip in bytes. Defaults: uploads/slips and 5242880 (5 MB).
# SLIP_STORAGE_DIR=uploads/slips
# SLIP_MAX_BYTES=5242880
# Runs the nightly jobs (late fees, later notifications) in this process. Enable on EXACTLY ONE
# instance. Default: on when NODE_ENV=production, off otherwise.
# SCHEDULER_ENABLED=true
# LINE Official Account (Messaging API) channel access token. Without it LINE is not used.
# LINE_CHANNEL_ACCESS_TOKEN=
# Web Push: all three or none. Generate the pair with `npm run vapid:generate` (keep the private key secret).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@your-domain.example
# Folder where an uploaded import file waits until the admin confirms (deleted after), and the largest
# accepted file in bytes. Defaults: uploads/imports and 2097152 (2 MB).
# IMPORT_STORAGE_DIR=uploads/imports
# IMPORT_MAX_BYTES=2097152

# DEV-TOOLS (temporary, development only): lets the admin run the automated tests from the web app.
# The API refuses to start with this on when NODE_ENV=production. Remove before the real deploy.
# DEV_TEST_RUNNER=true
