{
  "name": "loan-management-api",
  "version": "0.1.0",
  "private": true,
  "description": "Loan management API (ระบบขอยืมเงิน)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:validate": "prisma validate",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "admin:reset": "tsx src/scripts/reset-admin-password.ts",
    "vapid:generate": "tsx src/scripts/generate-vapid-keys.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "2.4.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "fflate": "^0.8.3",
    "jose": "^6.2.13",
    "read-excel-file": "^9.3.14",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
