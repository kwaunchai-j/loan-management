# Copy to .env.local. Never commit real values.
# Where the Next.js SERVER forwards /api/... requests (the API, see api/.env.example PORT).
# It is read on the server only and is not exposed to the browser.
API_URL=http://localhost:4000
# Largest slip image the form accepts, in whole MB (default 5). Must not exceed the API SLIP_MAX_BYTES.
# On Vercel a request body is limited to 4.5 MB: set 4 here and SLIP_MAX_BYTES=4194304 on the API.
# It is read when the web is BUILT (NEXT_PUBLIC_), so change it and redeploy.
# NEXT_PUBLIC_SLIP_MAX_MB=5
